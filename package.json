{
  "name": "axis-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Axis/ENRG Plug & Play PWA — сканирование QR устройства, локальный некастодиальный Solana-кошелёк, on-chain регистрация энерго-девайсов.",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:idl": "cp ../ENRG/target/idl/enrg_mvp.json src/data/enrg_mvp.json",
    "smoke": "vite build --config scripts/vite.smoke.config.ts && node /tmp/axis-smoke-out/smoke.cjs",
    "generate:icons": "bash scripts/generate-icons.sh"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "html5-qrcode": "^2.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
